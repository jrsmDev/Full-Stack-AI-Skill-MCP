<#
.SYNOPSIS
    Universal AI Skills Synchronizer for Claude Code and OpenCode.
    Scans 'FULL STACK AI SKILL', links skills globally via directory junctions,
    and maintains an up-to-date SKILLS_INDEX.md catalog.
#>

$sourceDir = $PSScriptRoot
$claudeDestDir = "$env:USERPROFILE\.claude\skills"
$openCodeDestDir = "$env:USERPROFILE\.config\opencode\skills"

# Ensure destination directories exist
if (-not (Test-Path $claudeDestDir)) {
    New-Item -ItemType Directory -Path $claudeDestDir -Force | Out-Null
}
if (-not (Test-Path $openCodeDestDir)) {
    New-Item -ItemType Directory -Path $openCodeDestDir -Force | Out-Null
}

Write-Host "==========================================================" -ForegroundColor Cyan
Write-Host "   Universal AI Skills Synchronizer (Claude Code + OpenCode)" -ForegroundColor Cyan
Write-Host "==========================================================" -ForegroundColor Cyan
Write-Host "Source:      $sourceDir" -ForegroundColor Yellow
Write-Host "Claude Code: $claudeDestDir" -ForegroundColor Yellow
Write-Host "OpenCode:    $openCodeDestDir`n" -ForegroundColor Yellow

$skills = Get-ChildItem -Path $sourceDir -Recurse -File -Filter "SKILL.md" | Where-Object {
    $_.FullName -notmatch "node_modules|\.git|dist|build|fixtures|tests"
}

$linkedClaude = 0
$linkedOpenCode = 0
$skippedClaude = 0
$skippedOpenCode = 0

$indexEntries = @()
$seenNames = @{}

foreach ($skillFile in $skills) {
    $skillFolder = $skillFile.Directory.FullName
    $baseName = $skillFile.Directory.Name
    
    # Handle duplicates by prefixing parent directory if needed
    if ($seenNames.ContainsKey($baseName)) {
        $parentName = (Split-Path (Split-Path $skillFolder -Parent) -Leaf)
        $skillName = "$parentName-$baseName"
    } else {
        $skillName = $baseName
        $seenNames[$baseName] = $true
    }

    # Extract description from YAML frontmatter if available
    $description = ""
    try {
        $content = Get-Content -Path $skillFile.FullName -TotalCount 25 -Raw -ErrorAction SilentlyContinue
        if ($content -match "description:\s*(.+)") {
            $description = $matches[1].Trim().Trim('"').Trim("'")
        }
    } catch {}

    # 1. Link to Claude Code skills
    $targetClaude = Join-Path $claudeDestDir $skillName
    if (-not (Test-Path $targetClaude)) {
        cmd /c mklink /J "$targetClaude" "$skillFolder" | Out-Null
        if ($LASTEXITCODE -eq 0) {
            $linkedClaude++
        }
    } else {
        $skippedClaude++
    }

    # 2. Link to OpenCode skills
    $targetOpenCode = Join-Path $openCodeDestDir $skillName
    if (-not (Test-Path $targetOpenCode)) {
        cmd /c mklink /J "$targetOpenCode" "$skillFolder" | Out-Null
        if ($LASTEXITCODE -eq 0) {
            $linkedOpenCode++
        }
    } else {
        $skippedOpenCode++
    }

    $relPath = $skillFile.FullName.Substring($sourceDir.Length).TrimStart("\/")
    $indexEntries += [PSCustomObject]@{
        Name        = $skillName
        Description = $description
        Path        = $relPath
    }
}

# 3. Generate SKILLS_INDEX.md
$indexFile = Join-Path $sourceDir "SKILLS_INDEX.md"
$indexContent = @(
    "# Master Skills Catalog Index",
    "",
    "This file is automatically generated by `sync_skills.ps1`. It indexes all specialized skills available to Claude Code and OpenCode.",
    "",
    "Total Skills Indexed: $($indexEntries.Count)",
    "",
    "| Skill Name | Description | Path |",
    "| :--- | :--- | :--- |"
)

foreach ($item in ($indexEntries | Sort-Object Name)) {
    $desc = if ($item.Description) { $item.Description } else { "Specialized AI workflow/skill" }
    # Sanitize markdown pipe
    $desc = $desc -replace '\|', '-'
    $indexContent += "| **$($item.Name)** | $desc | `$($item.Path)` |"
}

$indexContent -join "`r`n" | Set-Content -Path $indexFile -Encoding utf8

Write-Host " [+] Claude Code: $linkedClaude new linked, $skippedClaude already active" -ForegroundColor Green
Write-Host " [+] OpenCode:    $linkedOpenCode new linked, $skippedOpenCode already active" -ForegroundColor Green
Write-Host " [+] Generated:   $indexFile ($($indexEntries.Count) skills cataloged)" -ForegroundColor Green
Write-Host "`nAll skills are now globally available to Claude Code and OpenCode!" -ForegroundColor Cyan
Write-Host "==========================================================" -ForegroundColor Cyan
